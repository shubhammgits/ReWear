# Copy to .env.local for local runs; set the same names in Vercel for the live site.
# The city ReWear serves right now
NEXT_PUBLIC_CITY=Jaipur
# WhatsApp Business number with country code, digits only
NEXT_PUBLIC_WHATSAPP=919876543210
# Shown on the Terms, Privacy and Contact pages; Razorpay checks these before activation
NEXT_PUBLIC_LEGAL_NAME=Your full name or business name
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_ADDRESS=Full postal address, Delhi 110001

# Supabase: Project Settings → API Keys (and the Project URL from Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Secret: server only, never share or commit
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Razorpay: Dashboard in Test Mode → Account & Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Secret: server only, never share or commit
RAZORPAY_KEY_SECRET=your-test-key-secret
# Secret: set in Razorpay → Settings → Webhooks when you add https://your-site/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=a-long-random-string

# Set to "on" after enabling Google in Supabase → Authentication → Sign In / Providers (see README)
NEXT_PUBLIC_GOOGLE_SIGNIN=off
